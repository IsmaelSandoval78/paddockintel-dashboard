# Copy to .env.local and fill in real values — .env.local is gitignored and never committed.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (newsletter/digest emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Signing secret for the Resend webhook (app/api/webhooks/resend) -- create
# the webhook endpoint in the Resend dashboard first (Webhooks > Add Endpoint,
# URL https://paddockintel.com/api/webhooks/resend, events: email.sent,
# email.delivered, email.opened, email.clicked, email.bounced,
# email.complained), then paste the "Signing Secret" it gives you here (and
# as the RESEND_WEBHOOK_SECRET repo secret for the deploy workflows).
RESEND_WEBHOOK_SECRET=

# Cron-protected routes (daily digest, etc.)
CRON_SECRET=

# Draft/preview content access
DRAFT_SECRET=
