{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paddockintel-dashboard",
  "account_id": "dbf60dad00f30c6d52b094b3ec552f73",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "paddockintel-dashboard"
    }
  ],

  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "paddockintel-isr-cache"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],

  "triggers": {
    "crons": ["0 9 * * *"]
  }

  // Deliberately omitted — D1 tag cache (NEXT_TAG_CACHE_D1): the codebase has
  // zero calls to revalidateTag/revalidatePath today. Add a d1_databases block
  // + D1NextModeTagCache durable_objects binding + open-next.config.ts's
  // tagCache option if that ever changes.
}
